void handleCapture() {
    int total_arquivos = 0;
    String primeiro_arquivo = "";
    
    File root = LittleFS.open("/fotos");
    File file = root.openNextFile();
    
    while(file) {
        if(String(file.name()).endsWith(".jpg")) {
            total_arquivos++;
            if (primeiro_arquivo == "") {
                primeiro_arquivo = String(file.name());
            }
        }
        file = root.openNextFile();
    }
    
    if(total_arquivos >= LIMITE_FOTOS && primeiro_arquivo != "") {
        LittleFS.remove("/fotos/" + primeiro_arquivo);
    }

    unsigned long foto_id = millis() % 100000;
    String nome_final = "/fotos/foto_" + String(foto_id) + ".jpg";

    camera_fb_t* fb = esp_camera_fb_get();
    if (fb) {
        File out = LittleFS.open(nome_final, FILE_WRITE);
        if(out) {
            out.write(fb->buf, fb->len);
            out.close();
            log_sistema("Foto registrada rapidamente: " + nome_final);
        }
        esp_camera_fb_return(fb);
    }
    
    server.sendHeader("Location", "/");
    server.send(303, "text/plain", "");
}

void handleView() {
    String filename = server.arg("file");
    File f = LittleFS.open("/fotos/" + filename, FILE_READ);
    if (!f) {
        server.send(404, "text/plain", "Nao encontrado");
        return;
    }
    server.streamFile(f, "image/jpeg");
    f.close();
}

void handleDeletar() {
    String filename = server.arg("file");
    LittleFS.remove("/fotos/" + filename);
    log_sistema("Arquivo removido da Flash: " + filename);
    server.sendHeader("Location", "/");
    server.send(303, "text/plain", "");
}

void handleReset() {
    disparar_reset = true;
    server.sendHeader("Location", "/");
    server.send(303, "text/plain", "");
}

// ==========================================
// TAREFAS PARALELAS FREE RTOS
// ==========================================

void taskReset(void* pvParameters) {
    for(;;) {
        if (disparar_reset) {
            disparar_reset = false;
            status_local = "RESET TI";
            atualizar_oled_seguro("SISTEMA: RESET", "MODO EMERGENCY", "CIRCUITO ABERTO");
            digitalWrite(PIN_RELE, LOW);
            vTaskDelay(pdMS_TO_TICKS(5000));
            digitalWrite(PIN_RELE, HIGH);
            status_local = "ONLINE";
            atualizar_oled_seguro("IP: " + meu_ip, "Temp: " + String(temp_local, 1) + " C", "Status: " + status_local);
        }
        vTaskDelay(pdMS_TO_TICKS(100));
    }
}

void taskClima(void* pvParameters) {
    for(;;) {
        if (status_local == "ONLINE" && xSemaphoreTake(i2cMutex, pdMS_TO_TICKS(200)) == pdTRUE) {
            Wire.beginTransmission(0x40);
            Wire.write(0x00);
            Wire.endTransmission();
            vTaskDelay(pdMS_TO_TICKS(40));

            if(Wire.requestFrom(0x40, 4) == 4) {
                uint16_t t_raw = (Wire.read() << 8) | Wire.read();
                uint16_t u_raw = (Wire.read() << 8) | Wire.read();
                temp_local = (t_raw / 65536.0) * 165.0 - 40.0;
                umid_local = (u_raw / 65536.0) * 100.0;
            }
            xSemaphoreGive(i2cMutex);

            if (mqttClient.connected()) {
                mqttClient.publish(TOPIC_TEMP, String(temp_local, 2).c_str());
                vTaskDelay(pdMS_TO_TICKS(300));
                mqttClient.publish(TOPIC_UMID, String(umid_local, 2).c_str());
            }

            atualizar_oled_seguro("IP:" + meu_ip, "T:" + String(temp_local, 1) + "C U:" + String(umid_local, 1) + "%", "Status: " + status_local);
        }
        vTaskDelay(pdMS_TO_TICKS(10000));
    }
}

// ==========================================
// SETUP
// ==========================================
void setup() {
    WRITE_PERI_REG(RTC_CNTL_BIAS_CONF_REG, READ_PERI_REG(RTC_CNTL_BIAS_CONF_REG) & ~RTC_CNTL_BIAS_CONF_REG);
    Serial.begin(115200);
    
    pinMode(PIN_RELE, OUTPUT);
    digitalWrite(PIN_RELE, HIGH);
    pinMode(PIN_BOTAO, INPUT_PULLUP);
    attachInterrupt(digitalPinToInterrupt(PIN_BOTAO), tratar_botao_local, FALLING);

    i2cMutex = xSemaphoreCreateMutex();
    Wire.begin(PIN_SDA, PIN_SCL, 100000);

    if(!LittleFS.begin(true)){
        Serial.println("Falha ao montar LittleFS");
    } else {
        if(!LittleFS.exists("/fotos")) LittleFS.mkdir("/fotos");
    }

    if(oled.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
        oled.clearDisplay();
        oled.display();
    }

    log_sistema("--- Inicializando KiiRA v2.0 C++ ---");

    camera_config_t config;
    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;
    config.pin_d0 = Y2_GPIO_NUM;
    config.pin_d1 = Y3_GPIO_NUM;
    config.pin_d2 = Y4_GPIO_NUM;
    config.pin_d3 = Y5_GPIO_NUM;
    config.pin_d4 = Y6_GPIO_NUM;
    config.pin_d5 = Y7_GPIO_NUM;
    config.pin_d6 = Y8_GPIO_NUM;
    config.pin_d7 = Y9_GPIO_NUM;
    config.pin_xclk = XCLK_GPIO_NUM;
    config.pin_pclk = PCLK_GPIO_NUM;
    config.pin_vsync = VSYNC_GPIO_NUM;
    config.pin_href = HREF_GPIO_NUM;
    config.pin_sccb_sda = SIOD_GPIO_NUM;
    config.pin_sccb_scl = SIOC_GPIO_NUM;
    config.pin_pwdn = -1;
    config.pin_reset = -1;
    config.xclk_freq_hz = 20000000;
    config.pixel_format = PIXFORMAT_JPEG;
    config.frame_size = FRAMESIZE_QVGA;
    config.jpeg_quality = 15;              
    config.fb_count = 1;                    
    config.fb_location = CAMERA_FB_IN_DRAM; 

    if (esp_camera_init(&config) == ESP_OK) {
        log_sistema("Modulo optico OV5640 ativo (QVGA).");
    } else {
        log_sistema("Falha critica no sensor optico.");
    }

    WiFi.begin(WIFI_SSID, WIFI_PASS);
    int tentativa = 0;
    atualizar_oled_seguro("Conectando Wi-Fi", "Tentando rede:", WIFI_SSID);
    
    while (WiFi.status() != WL_CONNECTED && tentativa < 20) {
        delay(500);
        tentativa++;
    }

    if (WiFi.status() == WL_CONNECTED) {
        meu_ip = WiFi.localIP().toString();
        log_sistema("Conectado com IP: " + meu_ip);
        atualizar_oled_seguro("Wi-Fi: OK", "IP: " + meu_ip, "Adafruit Conn...");
        
        mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
        mqttClient.setCallback(mqtt_callback);
        verificar_conexao_mqtt();
    } else {
        WiFi.disconnect();
        WiFi.softAP("Gestor_Kiira", "kiira2026");
        meu_ip = WiFi.softAPIP().toString();
        log_sistema("Modo AP Operacional. SSID: Gestor_Kiira | IP: 192.168.4.1");
        atualizar_oled_seguro("REDE: GESTOR_KIIRA", "PAINEL WEB PRONTO", "IP: " + meu_ip);
    }

    server.on("/", handleRoot);
    server.on("/index.html", handleRoot);
    server.on("/video", handleVideo);
    server.on("/dados_atualizados", handleJSONData); 
    server.on("/capturar_agora", handleCapture);
    server.on("/ver", handleView);
    server.on("/deletar", handleDeletar);
    server.on("/action_reset", handleReset);
    server.begin();
    log_sistema("Servidor HTTP ativo na porta 8080.");

    xTaskCreatePinnedToCore(taskReset, "TaskReset", 2048, NULL, 1, NULL, 1);
    xTaskCreatePinnedToCore(taskClima, "TaskClima", 4096, NULL, 1, NULL, 1);
}

void loop() {
    server.handleClient();
    verificar_conexao_mqtt(); 
    delay(2);
}

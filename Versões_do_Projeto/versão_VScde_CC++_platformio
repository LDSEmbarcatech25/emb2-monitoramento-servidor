void log_sistema(String texto) {
    unsigned long segundos = millis() / 1000;
    String mensagem = "[" + String(segundos) + "s] " + texto;
    Serial.println(mensagem);
    historico_logs.push_back(mensagem);
    if (historico_logs.size() > 5) {
        historico_logs.erase(historico_logs.begin());
    }
}

void IRAM_ATTR tratar_botao_local() {
    unsigned long agora = millis();
    if (agora - ultimo_clique > 300) {
        ultimo_clique = agora;
        disparar_reset = true;
    }
}

void atualizar_oled_seguro(String l1, String l2, String l3) {
    if (xSemaphoreTake(i2cMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
        oled.clearDisplay();
        oled.setTextSize(1);
        oled.setTextColor(SSD1306_WHITE);
        oled.setCursor(5, 0);
        oled.print("Gestor_Kiira");
        oled.setCursor(0, 10);
        oled.print("----------------");
        oled.setCursor(0, 25);  oled.print(l1);
        oled.setCursor(0, 40);  oled.print(l2);
        oled.setCursor(0, 55);  oled.print(l3);
        oled.display();
        xSemaphoreGive(i2cMutex);
    }
}

void verificar_conexao_mqtt() {
    if (WiFi.status() == WL_CONNECTED) {
        if (!mqttClient.connected()) {
            String clientId = "kiira_" + String(random(10, 99));
            if (mqttClient.connect(clientId.c_str(), ADAFRUIT_USER, ADAFRUIT_KEY)) {
                mqttClient.subscribe(TOPIC_CMD);
                log_sistema("MQTT Reconectado com sucesso.");
            }
        }
        mqttClient.loop();
    }
}

void mqtt_callback(char* topic, byte* payload, unsigned int length) {
    String msg = "";
    for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];
    log_sistema("Nuvem Adafruit enviou comando: " + msg);
    if (msg == "HARD_RESET" || msg == "1") {
        disparar_reset = true;
    }
}


void handleVideo() {
    WiFiClient client = server.client();
    client.println("HTTP/1.1 200 OK");
    client.println("Content-Type: multipart/x-mixed-replace; boundary=frame");
    client.println();

    while (client.connected()) {
        verificar_conexao_mqtt();

        camera_fb_t* fb = esp_camera_fb_get();
        if (!fb) {
            vTaskDelay(pdMS_TO_TICKS(10));
            continue;
        }
        
        client.print("--frame\r\nContent-Type: image/jpeg\r\nContent-Length: " + String(fb->len) + "\r\n\r\n");
        client.write(fb->buf, fb->len);
        client.print("\r\n");
        
        esp_camera_fb_return(fb);
        vTaskDelay(pdMS_TO_TICKS(50));
    }
}

void handleJSONData() {
    String texto_logs = "";
    for(const auto& log : historico_logs) texto_logs += log + "\n";

    String json = "{";
    json += "\"temp\":" + String(temp_local, 1) + ",";
    json += "\"umid\":" + String(umid_local, 1) + ",";
    json += "\"status\":\"" + status_local + "\",";
    json += "\"logs\":\"" + texto_logs + "\"";
    json += "}";
    
    server.send(200, "application/json", json);
}

